#!/usr/bin/env bash
# Global pre-push hook (enabled via: git config --global core.hooksPath).
#
# 1. Chains to the repo's own .git/hooks/pre-push if present, since a global
#    core.hooksPath would otherwise hide it.
# 2. Blocks pushes containing secrets. Scans only the commits being pushed.
set -euo pipefail

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref being
# pushed. Capture it so it can be replayed to a chained local hook.
refs="$(cat)"

# Deliberately not --git-path hooks/pre-push: that resolves through
# core.hooksPath and would return this script itself.
local_hook="$(git rev-parse --absolute-git-dir)/hooks/pre-push"
if [ -x "$local_hook" ] && [ "$(realpath "$local_hook")" != "$(realpath "${BASH_SOURCE[0]}")" ]; then
    printf '%s\n' "$refs" | "$local_hook" "$@"
fi

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks not installed, skipping secret scan" >&2
    exit 0
fi

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue

    # Branch deletion: nothing to scan.
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        # New branch: scan its commits not already on any remote.
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi

    if ! gitleaks git --no-banner --redact --log-opts="$range" .; then
        echo "" >&2
        echo "pre-push: gitleaks found secrets in $local_ref, push blocked." >&2
        echo "To bypass (use sparingly): git push --no-verify" >&2
        exit 1
    fi
done <<< "$refs"

exit 0
