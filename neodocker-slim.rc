
neodocker-slim() {
  # Minimal wrapper for the slim image: BIND zone/config editing only
  # (nvim-rndc-zone + nvim-named-conf). Compared to neodocker.rc this drops
  # --privileged and the home-directory mounts, runs as the host user, and
  # makes the container filesystem read-only.
  #
  # Configure the rndczone plugin in ~/.neodocker-slim.env (untracked), e.g.:
  #   export RNDC_BIND_IP=127.0.0.1            # BIND server IP
  #   export RNDC_CATALOG_DOMAIN="catalog.example"  # catalog zone name
  #   export RNDC_TSIG_KEY="/etc/bind/tsig.key"     # TSIG key file for dig
  [ -f ~/.neodocker-slim.env ] && source ~/.neodocker-slim.env
  local run_args=()
  local base_path
  base_path="$(pwd)"
  run_args+=(--workdir "/data$base_path" -v "$base_path:/data$base_path:rw")

  # rndc.key / tsig keys, read-only
  if [ -d /etc/bind ]; then
    run_args+=(-v /etc/bind:/etc/bind:ro)
    # rndc.key is usually root:bind 640 — grant the container user the bind
    # group so rndc can read it.
    local bind_gid
    bind_gid="$(getent group bind | cut -d: -f3)"
    if [ -n "$bind_gid" ]; then
      run_args+=(--group-add "$bind_gid")
    fi
  fi

  docker run --rm -it \
    --init \
    --user "$(id -u):$(id -g)" \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --read-only \
    --tmpfs /tmp \
    -e HOME=/tmp/home \
    -e RNDC_BIND_IP \
    -e RNDC_CATALOG_DOMAIN \
    -e RNDC_TSIG_KEY \
    "${run_args[@]}" \
    registry.devries.tv/neodocker:slim-nightly "$@"
}
